fun squareNum(a) {
    return a * a;
}

print squareNum(2);
print squareNum(67);

class Vehicle {
    init(driver, vehicle) {
        this.driver = driver;
        this.vehicle = vehicle;
    }

    driving() {
        print this.driver + " is driving a " + this.vehicle;
    }
}

class Car < Vehicle {
    init(driver) {
        super.init(driver, "car");
    }
}

var randomCar = Car("John Doe");
randomCar.driving();

